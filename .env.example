# ---------------------------------------------------------------------------
# StratifyAI environment (placeholders only - never commit real values)
# Copy to .env (git-ignored) and edit. `python run.py setup` does this for you.
# ---------------------------------------------------------------------------

# Copilot mode: "offline" (default, no network, no key needed) or "llm".
# llm mode uses a generic OpenAI-compatible endpoint you configure here yourself.
COPILOT_MODE=offline
COPILOT_BASE_URL=
COPILOT_MODEL=
COPILOT_API_KEY=

# Demo account passwords (labelled DEMO). The owner password gates approvals;
# MONEY_MOVEMENT is denied for every role regardless of password.
DEMO_OWNER_PASSWORD=
DEMO_FINANCE_OPS_PASSWORD=
DEMO_VIEWER_PASSWORD=
DEMO_AUDITOR_PASSWORD=
